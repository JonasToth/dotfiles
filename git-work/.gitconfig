[user]
	email = jto@ivu.de
	name = Jonas Toth
[gpg]
	program = gpg2

[core]
    pager = delta

[pager]
    blame = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    features = side-by-side line-numbers decorations
    whitespace-error-style = 22 reverse
    wrap-max-lines = unlimited

[delta "decorations"]
    commit-decoration-style = bold yellow box ul
    file-style = bold yellow ul
    file-decoration-style = none
[pull]
	ff = only
[maintenance]
	repo = /mnt/code/repos/ivu-plan-source/src
[rebase]
	updateRefs = true
[scalar]
	repo = /mnt/code/repos/ivu-plan-source/src
[rerere]
	enabled = true
[merge]
	conflictStyle = diff3
[merge "mergiraf"]
	name = mergiraf
	driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L
[alias]
    # Difftastic aliases, so `git dlog -p` is `git log -p`
    # with difftastic and likewise for the other subcommands.
    dl = -c diff.external=difft log --ext-diff
    ds = -c diff.external=difft show --ext-diff
    dd = -c diff.external=difft diff
